{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/HTML/index.html" },
    { "source": "/HTML", "destination": "/HTML/index.html" },
    { "source": "/((?!HTML/|CSSS/|JSS/|file/|manifest\\.webmanifest|sw\\.js|index\\.html|COPYRIGHT\\.txt|humans\\.txt|robots\\.txt).*)", "destination": "/HTML/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
